      "method": "DELETE",
      "url": "{{ _.base_url }}/api/produtos/{{ _.produto_id }}",
      "headers": [],
      "body": {},
      "parameters": [],
      "scripts": {
        "afterResponse": "insomnia.test('Produto excluído', function () {\n  insomnia.expect(insomnia.response.code).to.eql(204);\n});"
