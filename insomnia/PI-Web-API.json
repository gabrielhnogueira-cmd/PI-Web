        "afterResponse": "insomnia.test('Payload incompleto rejeitado', function () {\n  const response = insomnia.response.json();\n  insomnia.expect(insomnia.response.code).to.eql(400);\n  insomnia.expect(response.erro).to.be.a('string');\n  insomnia.expect(response.campos).to.have.property('name');\n  insomnia.expect(response.campos).to.have.property('segmentId');\n});"
      }
