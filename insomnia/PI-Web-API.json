    {
      "_id": "req_create_product",
      "_type": "request",
      "parentId": "wrk_pi_web_api",
      "name": "Criar produto (POST)",
      "method": "POST",
      "url": "{{ _.base_url }}/api/produtos",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"  Cadinho   de laboratório  \",\n  \"segmentId\": \" LABORATORIO \",\n  \"material\": \" Porcelana   de alta alumina \",\n  \"description\": \" Recipiente para análise em laboratório. \",\n  \"price\": \"15,90\"\n}"
      },
      "parameters": [],
      "scripts": {
        "afterResponse": "insomnia.test('Produto normalizado e criado', function () {\n  const product = insomnia.response.json();\n  insomnia.expect(insomnia.response.code).to.eql(201);\n  insomnia.expect(product.id).to.be.a('number');\n  insomnia.expect(product.name).to.eql('Cadinho de laboratório');\n  insomnia.expect(product.segmentId).to.eql('laboratorio');\n  insomnia.expect(product.material).to.eql('Porcelana de alta alumina');\n  insomnia.expect(product.description).to.eql('Recipiente para análise em laboratório.');\n  insomnia.expect(product.price).to.eql(15.9);\n});\nif (insomnia.response.code === 201) insomnia.environment.set('produto_id', String(insomnia.response.json().id));"
      }
    },
    {
